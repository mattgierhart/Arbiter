{
	"name": "obsidian-arbiter",
	"version": "0.2.0",
	"description": "Arbiter — Agent Action Orchestration plugin for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest"
