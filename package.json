	"devDependencies": {
		"@types/node": "^22.0.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
